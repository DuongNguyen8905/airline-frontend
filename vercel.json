{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "http://duongdev-air-server.japaneast.cloudapp.azure.com:5000/api/:path*"
    },
    {
      "source": "/auth/:path*",
      "destination": "http://duongdev-air-server.japaneast.cloudapp.azure.com:5000/auth/:path*"
    },
    {
      "source": "/users/:path*",
      "destination": "http://duongdev-air-server.japaneast.cloudapp.azure.com:5000/users/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ]
}